rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Default deny catch-all
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isSignedIn() && (
        firestore.exists(/databases/ai-studio-hospitalhubdesig-7f7a6729-a1d2-48e8-ba86-ae6c290d754c/documents/users/$(request.auth.uid)) ||
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
      );
    }

    function getUserDoc() {
      return firestore.exists(/databases/ai-studio-hospitalhubdesig-7f7a6729-a1d2-48e8-ba86-ae6c290d754c/documents/users/$(request.auth.uid))
        ? firestore.get(/databases/ai-studio-hospitalhubdesig-7f7a6729-a1d2-48e8-ba86-ae6c290d754c/documents/users/$(request.auth.uid))
        : firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return hasUserDoc() &&
        getUserDoc().data.active == true;
    }

    function isAdmin() {
      return isActiveUser() &&
        getUserDoc().data.role == "admin";
    }

    function isFacilityUser(facilityId) {
      return isActiveUser() &&
        getUserDoc().data.role == "facility" &&
        getUserDoc().data.facilityId == facilityId;
    }

    function isOutsourceUser() {
      return isActiveUser() &&
        getUserDoc().data.role == "outsource";
    }

    function getOutsourceAppt(reportId) {
      return firestore.exists(/databases/ai-studio-hospitalhubdesig-7f7a6729-a1d2-48e8-ba86-ae6c290d754c/documents/outsource_appointments/$(reportId))
        ? firestore.get(/databases/ai-studio-hospitalhubdesig-7f7a6729-a1d2-48e8-ba86-ae6c290d754c/documents/outsource_appointments/$(reportId))
        : firestore.get(/databases/(default)/documents/outsource_appointments/$(reportId));
    }

    function isOutsourceApptExists(reportId) {
      return firestore.exists(/databases/ai-studio-hospitalhubdesig-7f7a6729-a1d2-48e8-ba86-ae6c290d754c/documents/outsource_appointments/$(reportId)) ||
        firestore.exists(/databases/(default)/documents/outsource_appointments/$(reportId));
    }

    function isAssignedOutsourceProvider(reportId, facilityId) {
      return isOutsourceUser() &&
        isOutsourceApptExists(reportId) &&
        getOutsourceAppt(reportId).data.facilityId == facilityId && (
          (getUserDoc().data.outsourceProviderId is string &&
           getUserDoc().data.outsourceProviderId.size() > 0 &&
           getOutsourceAppt(reportId).data.outsourceProviderId == getUserDoc().data.outsourceProviderId) ||
          (getUserDoc().data.providerId is string &&
           getUserDoc().data.providerId.size() > 0 &&
           getOutsourceAppt(reportId).data.providerId == getUserDoc().data.providerId)
        );
    }

    // File validation: PDF and common medical image types up to 20MB
    function isValidReportFile() {
      return request.resource.size <= 20 * 1024 * 1024 &&
        (request.resource.contentType.matches('application/pdf') ||
         request.resource.contentType.matches('image/(png|jpeg|jpg|webp)'));
    }

    // Facility medical diagnostic report files
    match /facilities/{facilityId}/reports/{reportId}/{fileName} {
      // READ: Authorized Facility Owner or Admin.
      // Paramedic, Outsource, other facilities, and unauthenticated: DENIED.
      allow read: if isSignedIn() && (isAdmin() || isFacilityUser(facilityId));

      // CREATE: Authorized Facility Owner or Admin for NEW files only.
      // Direct client-side overwriting of existing files is forbidden (resource == null).
      allow create: if isSignedIn() &&
        resource == null &&
        (isAdmin() || isFacilityUser(facilityId)) &&
        isValidReportFile();

      // UPDATE: Direct client-side same-path overwrite strictly DENIED.
      // Replacement must use secure backend versioning function.
      allow update: if false;

      // DELETE: Direct client-side deletion DENIED for all client accounts.
      allow delete: if false;
    }

    // Protected archived report versions
    match /facilities/{facilityId}/reports/{reportId}/archive/{archiveId}/{fileName} {
      allow read: if isSignedIn() && (isAdmin() || isFacilityUser(facilityId));
      allow create, update, delete: if false;
    }

    // Outsource diagnostic reports
    match /outsource/{facilityId}/reports/{reportId}/{fileName} {
      // READ: Owning Facility, Admin, or designated assigned Outsource provider.
      allow read: if isSignedIn() && (isAdmin() || isFacilityUser(facilityId) || isAssignedOutsourceProvider(reportId, facilityId));

      // CREATE: Assigned Outsource provider or Admin ONLY for NEW files (resource == null).
      // Unassigned Outsource providers and ordinary facility accounts MUST NOT upload files here.
      allow create: if isSignedIn() &&
        resource == null &&
        (isAdmin() || isAssignedOutsourceProvider(reportId, facilityId)) &&
        isValidReportFile();

      // UPDATE: Direct client-side same-path overwrite strictly DENIED.
      allow update: if false;

      // DELETE: Direct client-side deletion DENIED for all client accounts.
      allow delete: if false;
    }

    // Protected archived Outsource report versions
    match /outsource/{facilityId}/reports/{reportId}/archive/{archiveId}/{fileName} {
      allow read: if isSignedIn() && (isAdmin() || isFacilityUser(facilityId) || isAssignedOutsourceProvider(reportId, facilityId));
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------
    // SECURE RHEUMATOLOGY CLINICAL ATTACHMENTS (Stage 5)
    // -------------------------------------------------------------
    // Database: ai-studio-hospitalhubdesig-7f7a6729-a1d2-48e8-ba86-ae6c290d754c
    function getRheumUserDoc() {
      return firestore.exists(/databases/ai-studio-hospitalhubdesig-7f7a6729-a1d2-48e8-ba86-ae6c290d754c/documents/users/$(request.auth.uid))
        ? firestore.get(/databases/ai-studio-hospitalhubdesig-7f7a6729-a1d2-48e8-ba86-ae6c290d754c/documents/users/$(request.auth.uid))
        : firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function isRheumActiveUser() {
      return isSignedIn() &&
        (firestore.exists(/databases/ai-studio-hospitalhubdesig-7f7a6729-a1d2-48e8-ba86-ae6c290d754c/documents/users/$(request.auth.uid)) ||
         firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))) &&
        getRheumUserDoc().data.active == true;
    }

    function isRheumAdmin() {
      return isRheumActiveUser() &&
        getRheumUserDoc().data.role == "admin";
    }

    function isRheumDoctor() {
      return isRheumActiveUser() &&
        getRheumUserDoc().data.role == "doctor" &&
        getRheumUserDoc().data.doctorId is string &&
        getRheumUserDoc().data.doctorId.size() > 0;
    }

    function isRheumFacilityUser(facilityId) {
      return isRheumActiveUser() &&
        getRheumUserDoc().data.role == "facility" &&
        getRheumUserDoc().data.facilityId == facilityId;
    }

    function getRheumReferral(referralId) {
      return firestore.exists(/databases/ai-studio-hospitalhubdesig-7f7a6729-a1d2-48e8-ba86-ae6c290d754c/documents/rheumatology_appointments/$(referralId))
        ? firestore.get(/databases/ai-studio-hospitalhubdesig-7f7a6729-a1d2-48e8-ba86-ae6c290d754c/documents/rheumatology_appointments/$(referralId))
        : firestore.get(/databases/(default)/documents/rheumatology_appointments/$(referralId));
    }

    function rheumReferralExists(referralId) {
      return firestore.exists(/databases/ai-studio-hospitalhubdesig-7f7a6729-a1d2-48e8-ba86-ae6c290d754c/documents/rheumatology_appointments/$(referralId)) ||
        firestore.exists(/databases/(default)/documents/rheumatology_appointments/$(referralId));
    }

    function canFacilityMutateRheumAttachment(facilityId, referralId) {
      return isRheumFacilityUser(facilityId) &&
        rheumReferralExists(referralId) &&
        getRheumReferral(referralId).data.facilityId == facilityId &&
        (getRheumReferral(referralId).data.status == "Pending Doctor Review" ||
         getRheumReferral(referralId).data.status == "Returned to Facility");
    }

    function isValidRheumAttachmentFile() {
      return request.resource.size <= 10 * 1024 * 1024 &&
        (request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png']);
    }

    match /rheumatology/{facilityId}/{referralId}/{attachmentId}/{fileName} {
      // READ: Authorized Facility Owner, Active Doctor, or Admin.
      // Paramedic, Outsource, other facilities, and unauthenticated: DENIED.
      allow read: if isSignedIn() && (
        isRheumAdmin() ||
        isRheumDoctor() ||
        (isRheumFacilityUser(facilityId) &&
         rheumReferralExists(referralId) &&
         getRheumReferral(referralId).data.facilityId == facilityId)
      );

      // CREATE: Owning Facility only, while referral is in Pending Doctor Review or Returned to Facility.
      // Validated MIME (PDF, JPEG, PNG) & size (<= 10MB).
      // Overwriting existing file is forbidden.
      allow create: if isSignedIn() &&
        resource == null &&
        canFacilityMutateRheumAttachment(facilityId, referralId) &&
        isValidRheumAttachmentFile();

      // UPDATE: Strictly DENIED (No same-path overwrite). Replacement must use a new attachmentId.
      allow update: if false;

      // DELETE: Owning Facility only, while referral is in Pending Doctor Review or Returned to Facility.
      // Doctor, Paramedic, Admin, Outsource: DENIED.
      allow delete: if isSignedIn() &&
        canFacilityMutateRheumAttachment(facilityId, referralId);
    }
  }
}
