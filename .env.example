# .env.example
# Delayed Database Switch: Override active Firestore database ID when ready to cut over to (default).
# Leave unset or set to ai-studio-hospitalhubdesig-7f7a6729-a1d2-48e8-ba86-ae6c290d754c until migration parity is verified.
VITE_FIRESTORE_DATABASE_ID=ai-studio-hospitalhubdesig-7f7a6729-a1d2-48e8-ba86-ae6c290d754c

# Frontend Write Freeze / Maintenance Mode Gate ("true" | "false")
VITE_MAINTENANCE_MODE=false
