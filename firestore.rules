rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email == "admin@auth.local") || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        )
      );
    }

    function isFacilityUser() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.matches("facility_.*@auth\\.local")) || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "facility" &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        )
      );
    }

    // User profiles (secure and restricted)
    match /users/{uid} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && (
        request.auth.uid == uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Facility records (used for managing pre-created accounts & resets)
    match /facilities/{facilityId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && !exists(/databases/$(database)/documents/facilities/$(facilityId)));
    }

    // Admin first-time setup initialization config
    match /admin_config/{docId} {
      allow read: if true;
      allow write: if !exists(/databases/$(database)/documents/admin_config/setup);
    }

    // Standard secure helper for appointment records
    function canAccessRecord(record) {
      return isAdmin() || (
        isFacilityUser() && (
          record.facilityId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.facilityId || 
          record.facilityName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.facilityName
        )
      );
    }

    function canCreateRecord(record) {
      return isAdmin() || (
        isFacilityUser() && (
          record.facilityId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.facilityId || 
          record.facilityName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.facilityName
        )
      );
    }

    function canUpdateRecord(existingRecord, incomingRecord) {
      return isAdmin() || (
        isFacilityUser() && (
          existingRecord.facilityId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.facilityId || 
          existingRecord.facilityName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.facilityName
        ) && (
          incomingRecord.facilityId == existingRecord.facilityId || 
          incomingRecord.facilityName == existingRecord.facilityName
        )
      );
    }

    // Secure appointment collections
    match /echo_appointments/{docId} {
      allow read: if isSignedIn() && canAccessRecord(resource.data);
      allow create: if isSignedIn() && canCreateRecord(request.resource.data);
      allow update: if isSignedIn() && canUpdateRecord(resource.data, request.resource.data);
      allow delete: if isAdmin();
    }

    match /stress_test_appointments/{docId} {
      allow read: if isSignedIn() && canAccessRecord(resource.data);
      allow create: if isSignedIn() && canCreateRecord(request.resource.data);
      allow update: if isSignedIn() && canUpdateRecord(resource.data, request.resource.data);
      allow delete: if isAdmin();
    }

    match /holter_appointments/{docId} {
      allow read: if isSignedIn() && canAccessRecord(resource.data);
      allow create: if isSignedIn() && canCreateRecord(request.resource.data);
      allow update: if isSignedIn() && canUpdateRecord(resource.data, request.resource.data);
      allow delete: if isAdmin();
    }

    match /blood_pressure_appointments/{docId} {
      allow read: if isSignedIn() && canAccessRecord(resource.data);
      allow create: if isSignedIn() && canCreateRecord(request.resource.data);
      allow update: if isSignedIn() && canUpdateRecord(resource.data, request.resource.data);
      allow delete: if isAdmin();
    }

    match /lung_function_appointments/{docId} {
      allow read: if isSignedIn() && canAccessRecord(resource.data);
      allow create: if isSignedIn() && canCreateRecord(request.resource.data);
      allow update: if isSignedIn() && canUpdateRecord(resource.data, request.resource.data);
      allow delete: if isAdmin();
    }

    match /outsource_appointments/{docId} {
      allow read: if isSignedIn() && canAccessRecord(resource.data);
      allow create: if isSignedIn() && canCreateRecord(request.resource.data);
      allow update: if isSignedIn() && canUpdateRecord(resource.data, request.resource.data);
      allow delete: if isAdmin();
    }

    match /rheumatology_appointments/{docId} {
      allow read: if isSignedIn() && canAccessRecord(resource.data);
      allow create: if isSignedIn() && canCreateRecord(request.resource.data);
      allow update: if isSignedIn() && canUpdateRecord(resource.data, request.resource.data);
      allow delete: if isAdmin();
    }

    match /outsource_reports/{docId} {
      allow read: if isSignedIn() && canAccessRecord(resource.data);
      allow create: if isSignedIn() && canCreateRecord(request.resource.data);
      allow update: if isSignedIn() && canUpdateRecord(resource.data, request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
