        "id": { "type": "string" },
        "facilityId": { "type": "string" },
        "facilityName": { "type": "string" },
        "facilityCategory": { "type": "string" },
        "patientName": { "type": "string" },
        "mrn": { "type": "string" },
        "contactNumber": { "type": "string" },
        "email": { "type": "string" },
        "procedureType": { "type": "string" },
        "urgency": { "type": "string", "enum": ["Routine", "Urgent"] },
        "referringDoctor": { "type": "string" },
        "clinicalIndication": { "type": "string" },
        "diagnosis": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "scheduledDate": { "type": "string" },
        "resultFile": { "type": "object" }
      },
      "required": ["id", "facilityName", "patientName", "mrn", "status", "createdAt"]
    },
