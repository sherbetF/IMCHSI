    "rheumatology_appointments": {
      "title": "Rheumatology Appointments",
      "description": "Rheumatology clinic consultation and appointment requests separated by facility",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "facilityId": { "type": "string" },
        "facilityName": { "type": "string" },
        "facilityCategory": { "type": "string" },
        "patientName": { "type": "string" },
        "mrn": { "type": "string" },
        "contactNumber": { "type": "string" },
        "email": { "type": "string" },
        "procedureType": { "type": "string" },
        "urgency": { "type": "string", "enum": ["Routine", "Urgent"] },
        "referringDoctor": { "type": "string" },
        "clinicalIndication": { "type": "string" },
        "diagnosis": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "scheduledDate": { "type": "string" },
        "resultFile": { "type": "object" }
      },
      "required": ["id", "facilityName", "patientName", "mrn", "status", "createdAt"]
    },
    "rheumatology_attachments": {
      "title": "Rheumatology Clinical Attachments",
      "description": "Metadata for supporting clinical documents attached to Rheumatology referrals",
      "type": "object",
      "properties": {
        "attachmentId": { "type": "string" },
        "originalFileName": { "type": "string" },
        "storagePath": { "type": "string" },
        "contentType": { "type": "string", "enum": ["application/pdf", "image/jpeg", "image/png"] },
        "size": { "type": "number" },
        "uploadedAt": { "type": "string" },
        "uploadedByUid": { "type": "string" }
      },
      "required": [
        "attachmentId",
        "originalFileName",
        "storagePath",
        "contentType",
        "size",
        "uploadedAt",
        "uploadedByUid"
      ]
    },
    "rheumatology_attachment_control": {
      "title": "Rheumatology Attachment Control",
      "description": "Atomic control and race-safe reservation tracking for referral clinical attachments",
      "type": "object",
      "properties": {
        "activeAttachmentIds": { "type": "array" },
        "activeCount": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["activeAttachmentIds", "activeCount", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "users",
      "description": "User profiles with roles and facility associations"
    },
    "/facilities/{facilityId}": {
      "schema": "facilities",
      "description": "Public and administrative registry of medical facilities and setup states"
    },
    "/admin_config/{docId}": {
      "schema": "admin_config",
      "description": "Global administrative configurations"
    },
    "/echo_appointments/{docId}": {
      "schema": "echo_appointments",
      "description": "Echocardiogram appointment requests"
    },
    "/stress_test_appointments/{docId}": {
      "schema": "stress_test_appointments",
      "description": "Exercise stress test appointment requests"
    },
    "/holter_appointments/{docId}": {
      "schema": "holter_appointments",
      "description": "24H Holter monitoring appointment requests"
    },
    "/blood_pressure_appointments/{docId}": {
      "schema": "blood_pressure_appointments",
      "description": "24H Blood pressure monitoring appointment requests"
    },
    "/lung_function_appointments/{docId}": {
      "schema": "lung_function_appointments",
      "description": "Lung function and spirometry appointment requests"
    },
    "/outsource_appointments/{docId}": {
      "schema": "outsource_appointments",
      "description": "Outsource radiology and diagnostic report records"
    },
    "/rheumatology_appointments/{docId}": {
      "schema": "rheumatology_appointments",
      "description": "Rheumatology clinic consultation and appointment requests"
    },
    "/rheumatology_appointments/{docId}/attachments/{attachmentId}": {
      "schema": "rheumatology_attachments",
      "description": "Supporting clinical documents attached to Rheumatology referrals"
    },
    "/rheumatology_appointments/{docId}/attachment_control/{controlId}": {
      "schema": "rheumatology_attachment_control",
      "description": "Atomic slot reservation and limit control for referral clinical attachments"
    },
    "/outsource_reports/{docId}": {
      "schema": "outsource_appointments",
      "description": "Additional diagnostic report details for outsourced entries"
    }
  }
}
