{
  "entities": {
    "users": {
      "title": "User Profiles",
      "description": "Secure user profile mapping Firebase Auth UID to app role and facility details",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["admin", "facility"] },
        "facilityId": { "type": "string" },
        "facilityName": { "type": "string" },
        "category": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["role", "active"]
    },
    "facilities": {
      "title": "Facilities Registry",
      "description": "Metadata for primary care health clinics",
      "type": "object",
      "properties": {
        "facilityId": { "type": "string" },
        "facilityName": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Disabled"] },
        "uid": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["facilityId", "facilityName", "status"]
    },
    "admin_config": {
      "title": "Admin Configuration",
      "description": "Global administrator configuration variables",
      "type": "object",
      "properties": {
        "initialized": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["initialized"]
    },
    "echo_appointments": {
      "title": "Echo Appointments",
      "description": "Echocardiogram appointment requests separated by facility",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "facilityId": { "type": "string" },
        "facilityName": { "type": "string" },
        "facilityCategory": { "type": "string" },
        "patientName": { "type": "string" },
        "mrn": { "type": "string" },
        "contactNumber": { "type": "string" },
        "email": { "type": "string" },
        "procedureType": { "type": "string" },
        "urgency": { "type": "string", "enum": ["Routine", "Urgent"] },
        "referringDoctor": { "type": "string" },
        "clinicalIndication": { "type": "string" },
        "diagnosis": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "scheduledDate": { "type": "string" }
      },
      "required": ["id", "facilityName", "patientName", "mrn", "status", "createdAt"]
    },
    "stress_test_appointments": {
      "title": "Stress Test Appointments",
      "description": "Exercise stress test appointment requests separated by facility",
